* text=auto

# Anything whose SHA-256 is published as an integrity claim must never have its line
# endings rewritten on checkout — `text=auto` would turn LF into CRLF on Windows and
# silently invalidate the hash recorded in docs/dataset.md.
data/** -text
models/** -text

