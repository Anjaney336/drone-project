# Optional service settings. Missing measurements are never supplied through environment defaults.
# 8501 is AERIS's one canonical port, matching README.md, Dockerfile, and every demo script.
AERIS_API_URL=http://127.0.0.1:8501
AERIS_HOST=127.0.0.1
AERIS_PORT=8501
AERIS_LOG_LEVEL=INFO

# Optional shared-secret guard for state-changing requests (POST/PATCH/PUT/DELETE).
# Unset by default so the demo needs no setup. When set, those requests must carry
# an X-AERIS-Token header; reads stay open. GET /api/v1/health reports which mode is
# active as "write_protection", so an unguarded deployment is visibly unguarded.
# This is a deployment guard, not user authentication — it does not identify a
# reviewer. See docs/hazard_log.md.
# AERIS_API_TOKEN=change-me
